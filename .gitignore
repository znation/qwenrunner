# Model weights: ~50 GB total, and every .gguf is far over GitHub's 100 MB
# per-file limit. Fetch them per README "Prerequisites".
models/

# Build output and the vendored llama.cpp checkout (215 MB, has its own .git).
# Recreate with scripts/build.sh after cloning the pinned revision.
build/
third_party/

# Unpacked Debian shader tooling (glslc / libshaderc / spirv-headers).
# Recreate per README "Prerequisites".
tools/

# Scratch
__pycache__/
*.pyc
*.pyo

# Raw kernel-log dump. Contains a MAC address and the interface name derived
# from it, so it is not published; the relevant NVRM/BAR excerpts are quoted in
# README.md and RESULTS.md instead.
dmesg.log

# this one will change on every ./serve.sh run I think?
logs/serve.log

# Raw 0.5 s sampling telemetry from scripts/freqwatch.py and
# scripts/instrument_run.py — high-frequency streams, regenerated on every
# use and superseded by the committed result records (results/*.jsonl).
results/freq*.jsonl
results/instrument*.jsonl
