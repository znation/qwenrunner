# Model weights: ~50 GB total, and every .gguf is far over GitHub's 100 MB
# per-file limit. Fetch them per README "Prerequisites".
models/

# Build output and the vendored llama.cpp checkout (215 MB, has its own .git).
# Recreate with scripts/build.sh after cloning the pinned revision.
build/
third_party/

# Scratch
__pycache__/
*.pyc
*.pyo

# Rewritten on every ./serve.sh run, and any snapshot taken of one mid-session
# (e.g. logs/serve.flint.8091.log.pre-fa-patch).
logs/serve*.log
logs/serve*.log.*
logs/serve*.err

# Ad-hoc session captures -- op checks and one-off benches whose numbers are
# quoted in the docs. The docs carry the result, so these are not tracked.
logs/fa-tensor-patch-optest.log
